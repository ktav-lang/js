{
  "name": "@ktav-lang/ktav",
  "version": "0.1.4",
  "description": "Universal JS/TS bindings for Ktav — a plain configuration format with three rules, zero indentation, and zero quoting. WASM-backed, ships for Node, Deno, Bun, and browsers from a single package.",
  "license": "MIT",
  "author": "Marat K <phpcraftdream@gmail.com>",
  "homepage": "https://github.com/ktav-lang/js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ktav-lang/js.git"
  },
  "bugs": {
    "url": "https://github.com/ktav-lang/js/issues"
  },
  "keywords": [
    "ktav",
    "config",
    "configuration",
    "parser",
    "serializer",
    "wasm",
    "webassembly"
  ],
  "type": "module",
  "main": "./dist/ts/node.js",
  "types": "./dist/ts/node.d.ts",
  "browser": "./dist/ts/web.js",
  "exports": {
    ".": {
      "types": "./dist/ts/node.d.ts",
      "node": {
        "types": "./dist/ts/node.d.ts",
        "default": "./dist/ts/node.js"
      },
      "deno": {
        "types": "./dist/ts/web.d.ts",
        "default": "./dist/ts/web.js"
      },
      "bun": {
        "types": "./dist/ts/node.d.ts",
        "default": "./dist/ts/node.js"
      },
      "browser": {
        "types": "./dist/ts/web.d.ts",
        "default": "./dist/ts/web.js"
      },
      "default": {
        "types": "./dist/ts/bundler.d.ts",
        "default": "./dist/ts/bundler.js"
      }
    },
    "./ffi": {
      "deno": {
        "types": "./dist/ts/ffi-deno.d.ts",
        "default": "./dist/ts/ffi-deno.js"
      },
      "bun": {
        "types": "./dist/ts/ffi-bun.d.ts",
        "default": "./dist/ts/ffi-bun.js"
      },
      "default": {
        "types": "./dist/ts/ffi-error.d.ts",
        "default": "./dist/ts/ffi-error.js"
      }
    },
    "./wasm": {
      "types": "./dist/ts/web.d.ts",
      "default": "./dist/ts/web.js"
    }
  },
  "files": [
    "dist/ts/",
    "dist/wasm/",
    "README.md",
    "README.ru.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "lint:rust": "node scripts/lint-rust.mjs",
    "build:napi": "node scripts/build-napi.mjs",
    "build:wasm": "node -e \"import('child_process').then(c=>{const w=process.platform==='win32';c.execSync(w?'scripts\\\\build-wasm-windows.bat':'node scripts/build-wasm.mjs',{stdio:'inherit'})})\"",
    "build:ts": "tsc -p tsconfig.json",
    "build": "npm run build:napi && npm run build:wasm && npm run build:ts",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "test:node-napi": "node tests/run-node-napi.mjs",
    "test:node-wasm": "node tests/run-node-wasm.mjs",
    "test:bun": "bun run tests/run-bun.mjs",
    "test:bun-ffi": "bun run tests/run-bun-ffi.mjs",
    "test:deno": "deno run --allow-read --allow-env tests/run-deno.ts",
    "test:deno-ffi": "deno run --allow-ffi --allow-env --allow-read tests/run-deno-ffi.ts",
    "test:browser": "node tests/run-browser.mjs",
    "test": "npm run test:node-napi && npm run test:node-wasm && npm run test:bun && npm run test:bun-ffi && npm run test:deno && npm run test:deno-ffi && npm run test:browser"
  },
  "engines": {
    "node": ">=18"
  },
  "napi": {
    "binaryName": "ktav",
    "packageName": "@ktav-lang/js",
    "targets": [
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl"
    ]
  },
  "optionalDependencies": {
    "@ktav-lang/js-win32-x64-msvc": "0.1.4",
    "@ktav-lang/js-win32-arm64-msvc": "0.1.4",
    "@ktav-lang/js-darwin-x64": "0.1.4",
    "@ktav-lang/js-darwin-arm64": "0.1.4",
    "@ktav-lang/js-linux-x64-gnu": "0.1.4",
    "@ktav-lang/js-linux-arm64-gnu": "0.1.4",
    "@ktav-lang/js-linux-x64-musl": "0.1.4",
    "@ktav-lang/js-linux-arm64-musl": "0.1.4"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.6.2",
    "@types/node": "^25.6.0",
    "playwright": "^1.59.1",
    "typescript": "^6.0.3"
  }
}
